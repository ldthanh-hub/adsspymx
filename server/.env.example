# Sao chép file này thành .env khi chạy local. KHÔNG BAO GIỜ commit file .env thật vào git.

# Lấy từ Supabase/Neon sau khi tạo project (Settings > Database > Connection string)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Lấy từ developers.facebook.com sau khi tạo App (xem README bước 1)
META_ACCESS_TOKEN=

# Danh sách quốc gia mặc định (ISO 2 ký tự). Có thể để cố định 'MX'.
META_AD_COUNTRY=MX

PORT=4000
NODE_ENV=production

# Domain frontend thật (Vercel) sau khi deploy — dùng để giới hạn CORS, KHÔNG để "*"
CORS_ORIGIN=https://your-frontend.vercel.app
